# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already listed in .gitignore.
#
# Avoid "$" inside any value below. Env loaders expand $NAME, which silently
# corrupts the value. Stick to letters, digits and "-_:./" in secrets.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, Railway, ...).
# Neon gives you this on the project dashboard. Keep ?sslmode=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Razorpay -------------------------------------------------------------
# Dashboard > Settings > API Keys. Use rzp_test_* keys until you go live.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_key_secret_here"

# The SAME key id as above. This one is sent to the browser, which is fine —
# it is the publishable half of the pair. The secret above never is.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Dashboard > Settings > Webhooks. You choose this string when creating the
# webhook; paste the same value here.
RAZORPAY_WEBHOOK_SECRET="a_long_random_string_you_choose"

# --- Admin dashboard ------------------------------------------------------
# Generate both of these with:  npm run admin:hash -- "your password"
ADMIN_PASSWORD_HASH="scrypt:...:..."
SESSION_SECRET="at_least_32_random_characters"

# --- Email (optional but strongly recommended) ----------------------------
# resend.com — free tier covers this event comfortably.
# Without it the site still works; buyers just do not get an email.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Smirk Society <tickets@yourdomain.com>"
SUPPORT_EMAIL="joinsmirksociety@gmail.com"

# --- Site -----------------------------------------------------------------
# Used in ticket links and emails. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Total people the venue can hold. Orders are refused past this. It is a
# safety net, not a target — set it to the real limit for your venue.
VENUE_CAPACITY="500"
